---
import ActionButton from '@/components/ActionButton.astro';
import { profile } from '@/data/about';
import { withBase } from '@/utils/path';
---

<section class="relative border-b border-outline-variant grid grid-cols-1 md:grid-cols-12 min-h-[716px]">
  <div class="md:col-span-7 border-r border-outline-variant p-margin md:p-12 flex flex-col justify-center">
    <div class="mb-gutter">
      <span class="font-label-mono text-label-mono text-primary-container bg-primary-container/10 px-2 py-1">
        SYSTEM_ID: {profile.systemId}
      </span>
    </div>
    <h1 class="font-display-lg text-display-lg text-on-background mb-gutter uppercase max-w-2xl leading-none">
      {profile.name}
      <br />
      <span class="text-primary-container">({profile.alias})</span>
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl mb-8">
      {profile.bio}
    </p>
    <div class="mb-12">
      <ActionButton
        type="link"
        href={profile.cv.path}
        download={profile.cv.downloadName}
        variant="solid"
        class="inline-flex items-center gap-2 no-underline"
      >
        <span class="material-symbols-outlined text-base" aria-hidden="true">download</span>
        {profile.cv.label}
      </ActionButton>
    </div>
    <div class="flex flex-wrap gap-gutter">
      {
        profile.languages.map((lang) => (
          <div class="border border-outline-variant p-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">language</span>
            <span class="font-label-mono text-label-mono">
              {lang.code} ({lang.level})
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="md:col-span-5 relative bg-surface-container overflow-hidden flex items-center justify-center p-12">
    <div class="absolute inset-0 scanline" aria-hidden="true"></div>
    <div class="profile-portrait-frame">
      <div class="absolute -top-1 -left-1 w-4 h-4 border-t border-l border-primary-container" aria-hidden="true"></div>
      <div class="absolute -top-1 -right-1 w-4 h-4 border-t border-r border-primary-container" aria-hidden="true"></div>
      <div class="absolute -bottom-1 -left-1 w-4 h-4 border-b border-l border-primary-container" aria-hidden="true"></div>
      <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b border-r border-primary-container" aria-hidden="true"></div>
      <div class="profile-portrait-inner group">
        <img
          src={withBase(profile.portrait)}
          alt={profile.portraitAlt}
          class="profile-portrait-image opacity-90 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-0"
          loading="eager"
          decoding="async"
          width="1272"
          height="1269"
        />
        <div class="absolute bottom-4 left-4 font-label-mono text-[10px] text-primary-container/50 pointer-events-none">
          IMAGE_STREAM: ACTIVE
        </div>
      </div>
    </div>
  </div>
</section>
