---
import DataTag from './DataTag.astro';
import PanelHeaderBar from '@/components/ui/PanelHeaderBar.astro';
import ImageFrame from '@/components/ui/ImageFrame.astro';
import type { Project } from '@/types';

import { getProjectHref } from '@/data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = getProjectHref(project.slug);
---

<a
  href={href}
  class="bg-panel-bg p-6 h-full flex flex-col relative group hover:bg-[#1f1f1f] transition-colors duration-0 no-underline"
>
  <PanelHeaderBar label={`ID: ${project.id}`} class="group-hover:opacity-100" />

  <ImageFrame
    src={project.image}
    alt={project.imageAlt}
    class="mt-8 mb-4"
  />

  <h3 class="font-headline-md text-headline-md text-on-surface mb-4">{project.title}</h3>

  <div class="mt-auto flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <DataTag text={tag} color={project.tagColor} />
    ))}
  </div>
</a>
