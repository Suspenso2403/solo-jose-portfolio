---
import '@/styles/global.css';
import TechnicalGrid from '@/components/TechnicalGrid.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { siteConfig } from '@/data/site';
import { withBase } from '@/utils/path';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  mainClass?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  fullWidth = false,
  mainClass = '',
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} — ${siteConfig.name}`;
const mainClasses = [
  'flex-1 w-full',
  fullWidth ? '' : 'max-w-[80%] mx-auto py-[120px]',
  mainClass,
].filter(Boolean).join(' ');
---

<!doctype html>
<html lang={siteConfig.lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:locale" content={siteConfig.locale} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen">
    <TechnicalGrid />
    <div class="content-layer flex flex-col min-h-screen">
      <Header currentPath={Astro.url.pathname} />
      <main class={mainClasses}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  .material-symbols-outlined {
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
    vertical-align: middle;
  }
</style>
