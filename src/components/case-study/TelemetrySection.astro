---
import TelemetryBar from '@/components/ui/TelemetryBar.astro';
import type { CaseStudy } from '@/types/case-study';

interface Props {
  telemetry: NonNullable<CaseStudy['telemetry']>;
}

const { telemetry } = Astro.props;
---

<section class="border-b border-tech p-margin flex flex-col md:flex-row items-center gap-12 bg-background">
  <div class="w-full md:w-1/3 space-y-4">
    <div class="font-label-mono text-label-mono text-on-surface-variant mb-2 uppercase tracking-widest">
      SYSTEM_TELEMETRY:
    </div>
    <div class="space-y-6">
      {telemetry.bars.map((bar) => <TelemetryBar label={bar.label} value={bar.value} percent={bar.percent} />)}
    </div>
  </div>
  <div class="flex-1 flex flex-wrap gap-4 font-label-mono text-[10px]">
    {
      telemetry.tags.map((tag) => (
        <div class="border-tech px-4 py-2 text-on-surface-variant uppercase tracking-wider">{tag}</div>
      ))
    }
  </div>
</section>
