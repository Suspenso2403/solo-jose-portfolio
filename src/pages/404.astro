---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
---

<BaseLayout title="404 — Not Found" mainClass="!py-24">
  <section class="text-center max-w-xl mx-auto">
    <p class="font-label-mono text-label-mono text-primary-container mb-4">ERROR_CODE: 404</p>
    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-4">Route not found</h1>
    <p class="font-body-md text-body-md text-on-surface-variant mb-8">
      The requested node is offline or does not exist in this deployment.
    </p>
    <ActionButton type="link" href="/" variant="solid" class="px-6 py-3 inline-flex">
      Return home
    </ActionButton>
  </section>
</BaseLayout>
