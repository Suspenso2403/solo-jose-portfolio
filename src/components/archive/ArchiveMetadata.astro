---
import Panel from '@/components/ui/Panel.astro';
---

<section class="py-16 px-margin bg-background border-b border-grid-border">
  <div class="max-w-full grid grid-cols-1 md:grid-cols-3 gap-12">
    <div>
      <h2 class="font-label-mono text-label-mono uppercase mb-6 text-accent-orange">
        Archive_Parameters
      </h2>
      <ul class="space-y-4 font-label-mono text-label-mono text-on-surface-variant">
        <li class="flex justify-between border-b border-grid-border pb-2">
          <span>GRID_TYPE</span>
          <span class="text-on-surface">MODULAR_FIXED</span>
        </li>
        <li class="flex justify-between border-b border-grid-border pb-2">
          <span>BORDER_UNIT</span>
          <span class="text-on-surface">1PX_#333333</span>
        </li>
        <li class="flex justify-between border-b border-grid-border pb-2">
          <span>METADATA_FONT</span>
          <span class="text-on-surface">JETBRAINS_MONO</span>
        </li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <Panel padded class="border-grid-border">
        <div class="flex items-center gap-4 mb-4">
          <span class="material-symbols-outlined text-accent-orange">settings_input_component</span>
          <h4 class="font-headline-md text-headline-md uppercase">Structural_Verification</h4>
        </div>
        <p class="font-body-md text-on-surface-variant leading-relaxed mb-6">
          This interface operates as a rigid diagnostic tool for visual assessment. Every asset is
          categorized by semantic directory paths to maintain data integrity across the design
          system. Technical nodes marked as OFFLINE represent scheduled expansions in the visual
          database.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/design-system"
            class="border border-accent-orange text-accent-orange px-6 py-2 font-label-mono hover:bg-accent-orange hover:text-background transition-colors duration-0 no-underline"
          >
            PULL_SYSTEM_LOGS
          </a>
          <a
            href="/archive"
            class="border border-grid-border text-on-surface-variant px-6 py-2 font-label-mono hover:border-on-surface transition-colors duration-0 no-underline"
          >
            SYNC_DATA
          </a>
        </div>
      </Panel>
    </div>
  </div>
</section>
