---
interface Props {
  title: string;
  meta?: string;
  class?: string;
}

const { title, meta, class: className = '' } = Astro.props;
---

<div class:list={['section-header', className]}>
  <h2 class="font-headline-lg text-headline-lg text-on-surface">{title}</h2>
  {meta && (
    <span class="font-label-mono text-label-mono text-on-surface-variant">{meta}</span>
  )}
</div>
