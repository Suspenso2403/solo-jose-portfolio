---
import { withBase } from '@/utils/path';

interface Props {
  href: string;
  active?: boolean;
  class?: string;
}

const { href, active = false, class: className = '' } = Astro.props;
const resolvedHref = withBase(href);
---

<a
  href={resolvedHref}
  class:list={['nav-link', active ? 'nav-link-active' : 'nav-link-inactive', className]}
>
  <slot />
</a>
